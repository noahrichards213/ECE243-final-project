// including necessary libraries
#include <stdbool.h>
#include <stdlib.h>

const short int BLACK = 0x0000;
const short int YELLOW = 0xFF20;
const short int BLUE = 0x20FF;
short int WHITE = 0xFFFF;
short int RED = 0xF800;      // Vin Color
short int GREEN = 0x07E0;    // Vout Color
short int CYAN = 0x07FF;     // I_in Color
short int MAGENTA = 0xF81F;  // I_out Color

#define FPGA_CHAR_BASE 0x09000000
#define PIXEL_BUF_CTRL_BASE 0xFF203020

#define clock_rate 100000000
#define quarter_clock clock_rate / 4

#define KEY_BASE 0xff200050
#define TIMER_BASE 0xff202000
#define MTIME_BASE 0xff202100
#define LEDR_BASE 0xff200000
#define HEX3_HEX0_BASE 0xff200020

char buffer1[50] = {' '};
char buffer2[50] = {' '};
char buffer3[50] = {' '};
char buffer4[50] = {' '};
char buffer5[50] = {' '};
char buffer6[50] = {' '};
char buffer_clear[50] = {' '};

int voltage_buffer[2];
int current_buffer[3];

static void handler(void) __attribute__((interrupt("machine")));
void set_mtimer(void);
void set_itimer(void);
void set_KEY(void);
void SWI_ISR(void);
void itimer_ISR(void);
void KEY_ISR(void);

volatile int counter = 0;
volatile int digit = 0;
volatile int KEY_dir = 1;

volatile int redraw_graph = 1;

// determines whether text displays

int mode = 0;
// declaring draw line and clear screen
typedef struct {
  volatile double value;
  int x_start;
  int x_end;
  int y_start;
  int y_end;
  int radius;
  char type;
} Component;

Component circuit_components[4];

int voltage_div_array = 0;

char bit_codes[] = {0x3f, 0x06, 0x5b, 0x4f, 0x66, 0x6d, 0x7d, 0x07, 0x7f, 0x67};

void handler(void) {
  int mcause_value;
  __asm__ volatile("csrr %0, mcause" : "=r"(mcause_value));

  if (mcause_value == 0x80000003)
    SWI_ISR();
  else if (mcause_value == 0x80000007)
    mtimer_ISR();
  else if (mcause_value == 0x80000010)
    itimer_ISR();
  else if (mcause_value == 0x80000012)
    KEY_ISR();
}

void SWI_ISR(void) {
  volatile int* mtime_ptr = (int*)MTIME_BASE;
  counter = 0b1111111100;
  *(mtime_ptr + 4) = 0;
}

typedef long long int64;

void mtimer_ISR(void) {
  volatile unsigned int* mtime_ptr = (unsigned int*)MTIME_BASE;
  int64 mtimecmp64;

  mtimecmp64 = *(mtime_ptr + 3);
  mtimecmp64 = (mtimecmp64 << 32) | *(mtime_ptr + 2);
  mtimecmp64 = mtimecmp64 + (int64)quarter_clock;

  *(mtime_ptr + 2) = (unsigned int)mtimecmp64;
  *(mtime_ptr + 3) = (unsigned int)(mtimecmp64 >> 32);

  counter = counter + 1;
}

void itimer_ISR(void) {
  int new_digit;
  volatile int* timer_ptr = (int*)TIMER_BASE;

  *timer_ptr = 0;

  if (new_digit < 10 && new_digit > -1) digit = new_digit;
}

void KEY_ISR(void) {
  redraw_graph = 1;
  int pressed;
  volatile int* KEY_ptr = (int*)KEY_BASE;

  pressed = *(KEY_ptr + 3);

  // if we pressed key 0
  if (pressed == 0b0001) {
    circuit_components[voltage_div_array].value += 2;
  } else if (pressed == 0b0010) {
    if (circuit_components[voltage_div_array].value > 1) {
      circuit_components[voltage_div_array].value -= 2;
    }
  }

  else if (pressed == 0b0100) {
    if (voltage_div_array < 2) {
      voltage_div_array += 1;
    }

  } else if (pressed == 0b1000) {
    if (voltage_div_array > 0) {
      voltage_div_array -= 1;
    }
  }

  // clears the interrupt
  *(KEY_ptr + 3) = pressed;
}

void set_mtimer(void) {
  volatile int* mtime_ptr = (int*)MTIME_BASE;
  unsigned int mtime_h, mtime_l, carry, mtimecmp_l;

  do {
    mtime_h = *(mtime_ptr + 1);
    mtime_l = *(mtime_ptr);
  } while (*(mtime_ptr + 1) != mtime_h);

  mtimecmp_l = mtime_l + quarter_clock;
  carry = mtimecmp_l < mtime_l ? 1 : 0;

  *(mtime_ptr + 2) = mtimecmp_l;
  *(mtime_ptr + 3) = mtime_h + carry;
}

void set_itimer(void) {
  volatile int* timer_ptr = (int*)TIMER_BASE;

  int load_val = clock_rate;

  *(timer_ptr + 0x2) = (load_val & 0xFFFF);
  *(timer_ptr + 0x3) = (load_val >> 16) & 0xFFFF;

  *(timer_ptr + 1) = 0x7;
}

void set_KEY(void) {
  volatile int* KEY_ptr = (int*)KEY_BASE;

  *(KEY_ptr + 3) = 0xF;
  *(KEY_ptr + 2) = 0xF;
}

// global variable, used in multiple functiosn
int pixel_buffer_start;

void draw_line(int x0, int y0, int x1, int y1, short int color);
void swapnumber(int* x, int* y);
void plot_pixel(int x, int y, short int line_color);
void draw_cap(int x0, int x1, int y);
void draw_res(int x0, int x1, int y);
void draw_ground(int x0, int y1, int y);
void draw_circle(int xc, int yc, int r, short int line_colour);
void draw_half_circle(int xc, int yc, int r, short int line_colour);
void draw_power(int x0, int y0, int r);
void draw_current(int x0, int y0, int r);
void draw_inductor(int x0, int x1, int y);
void clear_screen();
void draw_dotted_line(int x0, int y0, int x1, int y1, short int color) {
  int y_step;

  bool is_steep = abs(y1 - y0) > abs(x1 - x0);
  if (is_steep) {
    swapnumber(&x0, &y0);
    swapnumber(&x1, &y1);
  }

  if (x0 > x1) {
    swapnumber(&x0, &x1);
    swapnumber(&y0, &y1);
  }

  int deltax = x1 - x0;
  int deltay = abs(y1 - y0);
  int error = -(deltax / 2);
  int y = y0;

  if (y0 < y1) {
    y_step = 1;
  } else {
    y_step = -1;
  }

  int dot_counter = 0;

  for (int x = x0; x <= x1; x++) {
    // Draw 3 pixels, skip 3 pixels
    if ((dot_counter / 3) % 2 == 0) {
      if (is_steep) {
        plot_pixel(y, x, color);
      } else {
        plot_pixel(x, y, color);
      }
    }

    dot_counter++;

    error += deltay;
    if (error >= 0) {
      y += y_step;
      error -= deltax;
    }
  }
}
void draw_rc_bode(int x_off, int y_off, int w, int h, double R, double C) {
  if (R <= 0 || C <= 0) return;

  double wc = 1.0 / (R * C);
  // We use a simple 3-decade plot: wc/10 to wc*100
  // In a LPF: 0dB until wc, then -20dB/decade slope

  int x_wc = x_off + (w / 3);    // Place cutoff at 1/3 of the width
  int y_0db = y_off - (h - 20);  // 0dB line near the top
  draw_dotted_line(x_wc, y_0db, x_wc, y_off, RED);

  // Axis
  draw_line(x_off, y_off, x_off + w, y_off, 0xFFFF);
  draw_line(x_off, y_off, x_off, y_off - h, 0xFFFF);

  video_text((x_off - 12) / 4, (y_off + 40) / 8, "0dB");
  video_text((x_off) / 4, (y_off + 130) / 8, "0Hz");

  // Flat part (below cutoff)
  draw_line(x_off, y_0db, x_wc, y_0db, RED);

  // Sloped part (above cutoff: -20dB per decade)
  // At one decade past wc (x_wc + w/3), drop by 20 units
  draw_line(x_wc, y_0db, x_off + w, y_0db + (h / 2), RED);
  sprintf(buffer6, "%lf Hz ", wc);

  video_text((x_off - 10) / 4, (y_off - 10) / 8, "Gain");
  video_text((x_off + 90) / 4, (y_off + 120) / 8, "Freq.");
  video_text(x_wc / 4 - 2, y_off / 4 + 1, buffer6);

  // Labels
};

void draw_rl_bode(int x_off, int y_off, int w, int h, double R, double L) {
  if (R <= 0 || L <= 0) return;

  double wc = R / L;  // cutoff frequency for RL: wc = R/L
  // Simple 3-decade plot: wc/10 to wc*100
  // High-pass: low gain below wc, rises to 0dB at wc, then flat at 0dB

  int x_wc = x_off + (w / 3);    // cutoff at 1/3 width
  int y_0db = y_off - (h - 20);  // 0dB line near top
  draw_dotted_line(x_wc, y_0db, x_wc, y_off, RED);

  // Axis
  draw_line(x_off, y_off, x_off + w, y_off, 0xFFFF);
  draw_line(x_off, y_off, x_off, y_off - h, 0xFFFF);

  video_text((x_off - 12) / 4, (y_off + 40) / 8, "0dB");
  video_text(x_off / 4, (y_off + 130) / 8, "0Hz");

  // Sloped part (below cutoff: +20dB/decade)
  draw_line(x_off, y_0db + (h / 2), x_wc, y_0db, RED);

  // Flat part (above cutoff)
  draw_line(x_wc, y_0db, x_off + w, y_0db, RED);

  sprintf(buffer6, "%lf Hz ", wc);

  video_text((x_off - 10) / 4, (y_off - 10) / 8, "Gain");
  video_text((x_off + 85) / 4, (y_off + 130) / 8, "Freq.");
  video_text(x_wc / 4 - 2, y_off / 4 + 1, buffer6);
}

void draw_voltage_time_graph(int x_off, int y_off, int w, int h, double vin,
                             double vout) {
  draw_line(x_off, voltage_buffer[0], x_off + w, voltage_buffer[0], BLACK);
  draw_line(x_off, voltage_buffer[1], x_off + w, voltage_buffer[1], BLACK);

  // 1. Draw Axes
  draw_line(x_off, y_off, x_off + w, y_off, WHITE);  // Time Axis (x)
  draw_line(x_off, y_off, x_off, y_off - h, WHITE);  // Voltage Axis (y)

  video_text((x_off - 12) / 4, (y_off) / 8, "22V");
  video_text((x_off - 10) / 4, ((y_off + 120) / 8), "0V");

  int y_vin = y_off - (int)((vin / 20.0) * h);
  int y_vout = y_off - (int)((vout / 20.0) * h);

  // Stay within bounds
  if (y_vin < y_off - h) y_vin = y_off - h;
  if (y_vout < y_off - h) y_vout = y_off - h;

  // 3. Draw Horizontal Lines
  draw_line(x_off, y_vin, x_off + w, y_vin, BLUE);   // Vin Line
  draw_line(x_off, y_vout, x_off + w, y_vout, RED);  // Vout Line

  // 4. On-Graph Labels (using video_text coordinates)
  video_text((x_off - 10) / 4, (y_off - 10) / 8, "Voltage");
  video_text((x_off + 90) / 4, (y_off + 120) / 8, "Time");
  voltage_buffer[0] = y_vin;
  voltage_buffer[1] = y_vout;
};

void draw_current_time_graph(int x_off, int y_off, int w, int h, double i_in,
                             double i_out1, double i_out2) {
  draw_line(x_off, current_buffer[0], x_off + w, current_buffer[0], BLACK);
  draw_line(x_off, current_buffer[1], x_off + w, current_buffer[1], BLACK);
  draw_line(x_off, current_buffer[2], x_off + w, current_buffer[2], BLACK);

  // 1. Draw Axes
  draw_line(x_off, y_off, x_off + w, y_off, WHITE);  // Time Axis (x)
  draw_line(x_off, y_off, x_off, y_off - h, WHITE);  // Current Axis (y)

  video_text((x_off - 12) / 4, (y_off) / 8, "22A");
  video_text((x_off - 10) / 4, ((y_off + 120) / 8), "0A");

  // 2. Map Currents to Pixel Height (Assuming 10A max scale)
  int y_iin = y_off - (int)((i_in / 15.0) * h);
  int y_iout1 = y_off - (int)((i_out1 / 15.0) * h);
  int y_iout2 = y_off - (int)((i_out2 / 15.0) * h);

  // Clamp values to stay within the graph box
  if (y_iin < y_off - h) y_iin = y_off - h;
  if (y_iout1 < y_off - h) y_iout1 = y_off - h;
  if (y_iout2 < y_off - h) y_iout2 = y_off - h;
  if (y_iin > y_off) y_iin = y_off;
  if (y_iout1 > y_off) y_iout1 = y_off;
  if (y_iout2 > y_off) y_iout2 = y_off;

  // 3. Draw Horizontal Lines
  draw_line(x_off, y_iin, x_off + w, y_iin, BLUE);         // Total Current
  draw_line(x_off, y_iout1, x_off + w, y_iout1, CYAN);     // Branch Current
  draw_line(x_off, y_iout2, x_off + w, y_iout2, MAGENTA);  // Branch Current

  // 4. Labels
  video_text((x_off - 10) / 4, (y_off - 10) / 8, "Current");
  video_text((x_off + 90) / 4, (y_off + 120) / 8, "Time");

  current_buffer[0] = y_iin;
  current_buffer[1] = y_iout1;
  current_buffer[2] = y_iout2;
};
void voltage_divider_cct(Component* V, Component* R1, Component* R2,
                         Component* G) {
  draw_power(V->x_start, V->y_start, V->radius);
  draw_res(R1->x_start, R1->x_end, R1->y_start);
  draw_res(R2->x_start, R2->x_end, R2->y_start);
  draw_line(V->x_start, V->y_start - 2 * V->radius,
            R1->x_end - (R1->x_end - R1->x_start), R1->y_end, YELLOW);
  draw_line(R1->x_start + 7 * abs((R1->x_end - R1->x_start) / 3) - 2,
            R1->y_start, R2->x_start - abs((R2->x_end - R2->x_start) / 3) + 2,
            R2->y_start, RED);
  draw_ground(G->x_start, G->x_end, G->y_start);
  draw_line(V->x_start, G->y_start, R2->x_end + (R2->x_end - R2->x_start),
            G->y_start, YELLOW);
  draw_line(R2->x_end + (R2->x_end - R2->x_start), R2->y_start,
            R2->x_end + (R2->x_end - R2->x_start), G->y_start, YELLOW);
};

void current_divider_cct(Component* I1, Component* R3, Component* R4,
                         Component* G) {
  draw_current(I1->x_start, I1->y_start, I1->radius);

  draw_res(R3->x_start, R3->x_end, R3->y_start);
  draw_res(R4->x_start, R4->x_end, R4->y_start);

  draw_line(I1->x_start, I1->y_start - 2 * I1->radius,
            R3->x_end - (R3->x_end - R3->x_start), R3->y_end, YELLOW);

  draw_line(I1->x_start, I1->y_start - 2 * I1->radius,
            R3->x_end - (R3->x_end - R3->x_start), R3->y_end, YELLOW);

  draw_line(I1->x_start, R3->y_start, I1->x_start, R4->y_start, YELLOW);

  draw_line(I1->x_start, R4->y_start, R4->x_start, R4->y_start, YELLOW);

  draw_ground(G->x_start, G->x_end, G->y_start);
  draw_line(I1->x_start, G->y_start, R4->x_end + (R4->x_end - R4->x_start) + 20,
            G->y_start, YELLOW);

  draw_line(R4->x_end + (R4->x_end - R4->x_start) + 20, R4->y_start,
            R4->x_end + (R4->x_end - R4->x_start) + 20, G->y_start, YELLOW);

  draw_line(R4->x_end + (R4->x_end - R4->x_start), R4->y_start,
            R4->x_end + (R4->x_end - R4->x_start) + 20, R4->y_start, CYAN);

  draw_line(R3->x_end + (R3->x_end - R3->x_start), R3->y_start,
            R3->x_end + (R3->x_end - R3->x_start) + 20, R3->y_start, MAGENTA);
}
void RC_circuit(Component* V, Component* R5, Component* C1, Component* G) {
  draw_power(V->x_start, V->y_start, V->radius);

  // Draw capacitor first
  draw_cap(C1->x_start, C1->x_end, C1->y_start);

  // Draw resistor second
  draw_res(R5->x_start, R5->x_end, R5->y_start);

  draw_ground(G->x_start, G->x_end, G->y_start);

  draw_line(V->x_start, G->y_start, C1->x_end, G->y_start, YELLOW);

  draw_line(V->x_start, R5->y_start, R5->x_start, R5->y_start, YELLOW);

  draw_line(C1->x_end, C1->y_end, C1->x_end, G->y_start, YELLOW);

  draw_line(R5->x_end + (R5->x_end - R5->x_start), C1->y_start, C1->x_start,
            C1->y_start, YELLOW);
};

void RL_circuit(Component* V, Component* R6, Component* L1, Component* G) {
  draw_power(V->x_start, V->y_start, V->radius);

  // Draw inductor first
  draw_inductor(L1->x_start, L1->x_end, L1->y_start);

  // Draw resistor second
  draw_res(R6->x_start, R6->x_end, R6->y_start);

  draw_ground(G->x_start, G->x_end, G->y_start);

  draw_line(V->x_start, G->y_start, L1->x_end - 10, G->y_start, YELLOW);

  draw_line(V->x_start, R6->y_start, R6->x_start, R6->y_start, YELLOW);

  draw_line(L1->x_end - 10, R6->y_end, L1->x_end - 10, G->y_start, YELLOW);

  draw_line(R6->x_end + (R6->x_end - R6->x_start), R6->y_start, L1->x_start - 5,
            R6->y_start, YELLOW);
}

void video_text(int x, int y, char* text_ptr) {
  int offset;
  volatile char* character_buffer = (char*)FPGA_CHAR_BASE;

  // each row in the character buffer is 128 characters wide
  offset = (y << 7) + x;  // same as y*128 + x

  while (*text_ptr) {
    *(character_buffer + offset) = *text_ptr;
    ++text_ptr;
    ++offset;
  }
}

void clear_text(char* buffer1, char* buffer2, char* buffer3, char* buffer4,
                char* buffer5) {
  for (int i = 0; i < 50; i++) {
    buffer1[i] = ' ';
    buffer2[i] = ' ';
    buffer3[i] = ' ';
    buffer4[i] = ' ';
    buffer5[i] = ' ';
  }
}

int main(void) {
  for (int x = 0; x < 80; x++) {
    for (int y = 0; y < 60; y++) {
      video_text(x, y, buffer_clear);
    }
  }
  // initializing pointers
  volatile int* mtime_ptr = (int*)MTIME_BASE;
  volatile int* LEDR_ptr = (int*)LEDR_BASE;
  volatile int* HEX3_HEX0_ptr = (int*)HEX3_HEX0_BASE;

  set_mtimer();
  set_itimer();
  set_KEY();

  int mstatus_value, mtvec_value, mie_value;

  // disable global interrupts
  mstatus_value = 0b1000;
  __asm__ volatile("csrc mstatus, %0" ::"r"(mstatus_value));

  // set interrupt handler address
  mtvec_value = (int)&handler;
  __asm__ volatile("csrw mtvec, %0" ::"r"(mtvec_value));

  // disable current interrupts
  __asm__ volatile("csrr %0, mie" : "=r"(mie_value));
  __asm__ volatile("csrc mie, %0" ::"r"(mie_value));

  // enable key and timers
  mie_value = 0x50088;
  __asm__ volatile("csrs mie, %0" ::"r"(mie_value));

  // reenable global interrupts
  __asm__ volatile("csrs mstatus, %0" ::"r"(mstatus_value));

  // enables machine timer software interrupt
  *(mtime_ptr + 4) = 1;

  *HEX3_HEX0_ptr = 0x3f;

  // 1. Initialize Hardware Pointers
  volatile int* pixel_ctrl_ptr = (int*)0xFF203020;
  pixel_buffer_start = *pixel_ctrl_ptr;
  volatile int* PS2_ptr = (int*)0xFF200100;

  // Define circuit components to be used in an array

  // voltage divider comoponents
  Component R1 = {10.0, 100, 120, 80, 80, -1, 'R'};
  Component R2 = {15.0, 150, 170, 80, 80, -1, 'R'};

  // current divider components
  Component R3 = {10.0, 100, 120, 80, 80, -1, 'R'};
  Component R4 = {15.0, 100, 120, 30, 30, -1, 'R'};

  // RC circuit components
  Component R5 = {10.0, 100, 120, 80, 80, -1, 'R'};
  Component C1 = {10, 150, 170, 80, 80, -1, 'C'};

  // RL circuit components
  Component R6 = {10.0, 100, 120, 80, 80, -1, 'R'};
  Component L1 = {10.0, 160, 210, 83, 83, -1, 'L'};

  // same everywhere
  Component V1 = {10.0, 60, -1, 120, -1, 20, 'V'};
  Component I1 = {10.0, 60, -1, 120, -1, 20, 'I'};
  Component GND = {-1, 140, 120, 160, 160, -1, 'G'};

  int breakcode = 0;
  unsigned char byte = 0;
  int PS2_data, RVALID;

  // Optional: Start with a blank screen
  clear_screen();

  while (1) {
    // ---------------- MODE 1 : Voltage Divider ----------------
    if (mode == 1) {
      int voltage = circuit_components[0].value;
      int res1 = circuit_components[1].value;
      int res2 = circuit_components[2].value;
      double divided_voltage = voltage * ((double)res2 / (double)(res1 + res2));

      // only numbers are variable
      sprintf(buffer1, "%d", voltage);
      sprintf(buffer2, "%d", res1);
      sprintf(buffer3, "%d", res2);
      sprintf(buffer4, "%.2lf", divided_voltage);

      video_text(10, 5, "Voltage Divider");

      // Source voltage
      video_text(5, 30, buffer1);
      video_text(8, 30, "V");

      // R1
      video_text(26, 22, buffer2);
      video_text(29, 22, "ohms");

      // R2
      video_text(36, 22, buffer3);
      video_text(39, 22, "ohms");

      // Output voltage
      video_text(30, 15, buffer4);
      video_text(36, 15, "V");

      video_text(36, 17, buffer5);

      if (redraw_graph) {
        draw_voltage_time_graph(210, 120, 80, 60, voltage, divided_voltage);
      }
    }

    // ---------------- MODE 2 : Current Divider ----------------
    else if (mode == 2) {
      int current = circuit_components[0].value;
      int res3 = circuit_components[1].value;
      int res4 = circuit_components[2].value;

      double current1 = current * ((double)res3 / (double)(res3 + res4));
      double current2 = current * ((double)res4 / (double)(res3 + res4));

      // only numbers are variable
      sprintf(buffer1, "%d", current);
      sprintf(buffer2, "%d", res3);
      sprintf(buffer3, "%d", res4);
      sprintf(buffer4, "%.2lf", current1);
      sprintf(buffer5, "%.2lf", current2);

      video_text(10, 5, "Current Divider");

      // Source current
      video_text(5, 30, buffer1);
      video_text(8, 30, "A");

      // Top resistor
      video_text(26, 22, buffer2);
      video_text(29, 22, "ohms");

      // Bottom resistor
      video_text(26, 10, buffer3);
      video_text(29, 10, "ohms");

      // Branch current 1
      video_text(41, 10, buffer4);
      video_text(47, 10, "A");

      // Branch current 2
      video_text(41, 19, buffer5);
      video_text(47, 19, "A");

      if (redraw_graph) {
        draw_current_time_graph(217, 120, 80, 60, current, current1, current2);
      }
    }

    // ---------------- MODE 3 : RC Circuit ----------------
    else if (mode == 3) {
      int voltage = circuit_components[0].value;
      int res5 = circuit_components[1].value;
      int cap1 = circuit_components[2].value;

      // only numbers are variable
      sprintf(buffer1, "%d", voltage);
      sprintf(buffer2, "%d", res5);
      sprintf(buffer3, "%d", cap1);

      video_text(10, 5, "RC circuit");

      // Source voltage
      video_text(5, 30, buffer1);
      video_text(8, 30, "V");

      // Resistor
      video_text(26, 22, buffer2);
      video_text(29, 22, "ohms");

      // Capacitor
      video_text(36, 22, buffer3);
      video_text(39, 22, "F");

      if (redraw_graph) {
        draw_rc_bode(200, 120, 80, 60, res5, cap1);
      }
    } else if (mode == 4) {
      int voltage = circuit_components[0].value;
      int res6 = circuit_components[1].value;
      int inductance = circuit_components[2].value;

      sprintf(buffer1, "%d", voltage);
      sprintf(buffer2, "%d", res6);
      sprintf(buffer3, "%d", inductance);

      video_text(10, 5, "RL circuit");

      // Source voltage
      video_text(5, 30, buffer1);
      video_text(8, 30, "V");

      // Resistor
      video_text(26, 22, buffer2);
      video_text(29, 22, "ohms");

      // Inductor
      video_text(38, 22, buffer3);
      video_text(41, 22, "H");

      if (redraw_graph) {
        draw_rl_bode(220, 120, 80, 60, res6, inductance);
      }
    }

    if (redraw_graph) {
      redraw_graph = 0;
    }

    // interrupts
    *LEDR_ptr = counter;

    // interrupts
    PS2_data = *(PS2_ptr);         // Read PS/2 Data register
    RVALID = (PS2_data & 0x8000);  // Extract RVALID field

    if (RVALID != 0) {
      byte = PS2_data & 0xFF;  // Get the scan code

      if (byte == 0xF0) {
        breakcode = 1;  // Found break code prefix
      } else {
        if (breakcode) {
          for (int x = 0; x < 80; x++) {
            for (int y = 0; y < 60; y++) {
              video_text(x, y, buffer_clear);
            }
          }
          // Logic triggers on key RELEASE
          switch (byte) {
            case 0x23:  // 'D' key scan code
              mode = 1;
              clear_screen();

              clear_text(buffer1, buffer2, buffer3, buffer4, buffer5);

              circuit_components[0] = V1;
              circuit_components[1] = R1;
              circuit_components[2] = R2;
              int voltage_divider = circuit_components[0].value;
              int res1_divider = circuit_components[1].value;
              int res2_divider = circuit_components[2].value;
              double divided_voltage_divider =
                  voltage_divider * ((double)res2_divider /
                                     (double)(res1_divider + res2_divider));

              voltage_divider_cct(&V1, &R1, &R2, &GND);

              break;

            case 0x21:  // 'C' key scan code
              mode = 2;
              clear_screen();

              clear_text(buffer1, buffer2, buffer3, buffer4, buffer5);

              circuit_components[0] = I1;
              circuit_components[1] = R3;
              circuit_components[2] = R4;

              current_divider_cct(&I1, &R3, &R4, &GND);

              break;

            case 0x2D:  // 'R' key scan code
              mode = 3;
              clear_screen();

              clear_text(buffer1, buffer2, buffer3, buffer4, buffer5);

              circuit_components[0] = V1;
              circuit_components[1] = R5;
              circuit_components[2] = C1;

              RC_circuit(&V1, &R5, &C1, &GND);

              break;

            case 0x4B:  // 'L' key scan code
              mode = 4;
              clear_screen();

              clear_text(buffer1, buffer2, buffer3, buffer4, buffer5);

              circuit_components[0] = V1;
              circuit_components[1] = R6;
              circuit_components[2] = L1;

              RL_circuit(&V1, &R6, &L1, &GND);

              break;
          }
          breakcode = 0;  // Reset breakcode flag
        }
      }
    }
  }
  return 0;
}

// plots the colour of a pixel at point (x, y)
void plot_pixel(int x, int y, short int line_color) {
  volatile short int* one_pixel_address;
  one_pixel_address = pixel_buffer_start + (y << 10) + (x << 1);

  *one_pixel_address = line_color;
}

// draws line from (x0, y0) to (x1, y1) with colour color
void draw_line(int x0, int y0, int x1, int y1, short int color) {
  int y_step;

  bool is_steep = abs(y1 - y0) > abs(x1 - x0);
  if (is_steep) {
    swapnumber(&x0, &y0);
    swapnumber(&x1, &y1);
  }
  if (x0 > x1) {
    swapnumber(&x0, &x1);
    swapnumber(&y0, &y1);
  }
  int deltax = x1 - x0;
  int deltay = abs(y1 - y0);
  int error = -(deltax / 2);
  int y = y0;
  if (y0 < y1) {
    y_step = 1;
  } else {
    y_step = -1;
  }

  for (int x = x0; x <= x1; x++) {
    if (is_steep) {
      plot_pixel(y, x, color);
    } else {
      plot_pixel(x, y, color);
    }
    error = error + deltay;
    if (error >= 0) {
      y = y + y_step;
      error = error - deltax;
    }
  }
}

// swaps two numbers for Bresenham’s algorithm
void swapnumber(int* x, int* y) {
  int temp = *x;
  *x = *y;
  *y = temp;
}

void clear_screen() {
  for (int x = 0; x < 320; x++) {
    for (int y = 0; y < 240; y++) {
      plot_pixel(x, y, BLACK);
    }
  }
}

void draw_cap(int x0, int x1, int y) {
  int cap_size = (1.0 / 3.0) * (x1 - x0);
  draw_line(x0, y, x0 + cap_size, y, YELLOW);
  draw_line(x0 + 2 * cap_size, y, x1, y, YELLOW);
  draw_line(x0 + cap_size, y - cap_size, x0 + cap_size, y + cap_size, YELLOW);
  draw_line(x0 + 2 * cap_size, y - cap_size, x0 + 2 * cap_size, y + cap_size,
            YELLOW);
}

void draw_res(int x0, int x1, int y) {
  int res_size = abs((x1 - x0) / 3);
  int last_pos_x;
  draw_line(x0 - res_size / 2, y, x0 - res_size, y, YELLOW);
  draw_line(x0 - res_size / 2, y, x0, y - res_size, YELLOW);
  for (int i = 0; i < 6; i = i + 2) {
    draw_line(x0 + (i + 2) * res_size, y - res_size, x0 + (i + 1) * res_size,
              y + res_size, YELLOW);
    draw_line(x0 + i * res_size, y - res_size, x0 + (i + 1) * res_size,
              y + res_size, YELLOW);
    last_pos_x = x0 + (i + 2) * res_size;
  }
  draw_line(last_pos_x, y - res_size, last_pos_x + res_size / 2, y, YELLOW);
  draw_line(last_pos_x + res_size / 2, y, last_pos_x + res_size, y, YELLOW);
}

void draw_ground(int x0, int x1, int y) {
  int ground_size = (x1 - x0) / 6;
  draw_line(x0, y, x0 + 6 * ground_size, y, YELLOW);
  draw_line(x0 + ground_size, y - ground_size, x0 + 5 * ground_size,
            y - ground_size, YELLOW);
  draw_line(x0 + 2 * ground_size, y - 2 * ground_size, x0 + 4 * ground_size,
            y - 2 * ground_size, YELLOW);
}

void draw_power(int x0, int y0, int r) {
  draw_circle(x0, y0, r, BLUE);
  draw_line(x0 - r / 2, y0 - r / 2, x0, y0 + r / 2, BLUE);
  draw_line(x0, y0 + r / 2, x0 + r / 2, y0 - r / 2, BLUE);
  // top line
  draw_line(x0, y0 - 2 * r, x0, y0 - r, BLUE);

  // bottom line
  draw_line(x0, y0 + 2 * r, x0, y0 + r, BLUE);
}

void draw_current(int x0, int y0, int r) {
  draw_circle(x0, y0, r, BLUE);
  draw_line(x0, y0 + r / 2, x0, y0 - r / 2, BLUE);
  draw_line(x0 - r / 2, y0, x0, y0 - r / 2, BLUE);
  draw_line(x0, y0 - r / 2, x0 + r / 2, y0, BLUE);
  // top line
  draw_line(x0, y0 - 2 * r, x0, y0 - r, BLUE);

  // bottom line
  draw_line(x0, y0 + 2 * r, x0, y0 + r, BLUE);
}

void draw_inductor(int x0, int x1, int y) {
  int width = x1 - x0;

  int lead_len = width / 6;
  int coil_spacing = width / 4;
  int radius = coil_spacing / 2;

  // left lead
  draw_line(x0 - lead_len, y - radius / 2, x0 - radius / 2, y - radius / 2,
            YELLOW);

  // 4 half-circles across the width
  for (int i = 0; i < 4; i++) {
    draw_half_circle(x0 + i * (radius + 3), y, radius, YELLOW);
  }

  // right lead
  draw_line(x0 + 2 * coil_spacing + radius, y - radius / 2, x1 - coil_spacing,
            y - radius / 2, YELLOW);
}

void draw_circle(int xc, int yc, int r, short int line_colour) {
  int x = 0;
  int y = r;
  int p = 1 - r;  // Decision parameter

  while (x <= y) {
    // Plot the 8 symmetric points

    plot_pixel(xc + x, yc + y, line_colour);
    plot_pixel(xc - x, yc + y, line_colour);
    plot_pixel(xc + x, yc - y, line_colour);
    plot_pixel(xc - x, yc - y, line_colour);

    plot_pixel(xc + y, yc + x, line_colour);
    plot_pixel(xc - y, yc + x, line_colour);
    plot_pixel(xc + y, yc - x, line_colour);
    plot_pixel(xc - y, yc - x, line_colour);

    x++;

    if (p < 0) {
      // Midpoint is inside circle
      p = p + 2 * x + 1;
    } else {
      // Midpoint is outside/on circle
      y--;
      p = p + 2 * x + 1 - 2 * y;
    }
  }
}

void draw_half_circle(int xc, int yc, int r, short int line_colour) {
  int x = 0;
  int y = r;
  int p = 1 - r;  // Decision parameter

  while (x <= y) {
    // Plot the 8 symmetric points

    plot_pixel(xc + x, yc - y, line_colour);
    plot_pixel(xc - x, yc - y, line_colour);

    x++;

    if (p < 0) {
      // Midpoint is inside circle
      p = p + 2 * x + 1;
    } else {
      // Midpoint is outside/on circle
      y--;
      p = p + 2 * x + 1 - 2 * y;
    }
  }
}